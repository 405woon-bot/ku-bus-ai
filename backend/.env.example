# 이 파일을 .env로 복사하고 값을 채우세요:  cp .env.example .env   (.env는 Git에 올리지 마세요)
PORT=8787

# ── 서울시 버스 Open API (공공데이터포털에서 정류소정보조회·노선정보조회 활용 신청 → 같은 일반 인증키) ──
# 서버에만 둡니다. 프런트엔드(HTML/JS)에는 절대 넣지 마세요. 비워 두면 예시(모의) 데이터로 동작합니다.
SEOUL_BUS_API_KEY=
# 기본값은 공식 활용가이드의 서비스 URL입니다(http://ws.bus.go.kr/api/rest).
SEOUL_BUS_BASE_URL=
# 응답 형식: xml(API 기본) | json(resultType=json). 어느 쪽이 와도 해석합니다.
SEOUL_BUS_FORMAT=xml
# 인증키 파라미터 이름: 가이드 예제 URL은 ServiceKey, 일부 요청 표는 serviceKey로 표기 — 인증 오류가 나면 바꿔 보세요.
SEOUL_BUS_KEY_PARAM=ServiceKey
# 서울시 API 응답 대기 시간(ms)
SEOUL_BUS_TIMEOUT_MS=6000
# 캐시 시간(초). 같은 노선·정류장은 이 시간 안에 다시 부르지 않습니다. 개발계정 일일 호출 한도를 확인하고 정하세요.
LIVE_CACHE_SEC=30
# 탑승 정류장 화면에서 노선 경유 정류소(구간 거리·속도)를 다시 부르는 간격(초). 노선정보는 하루 한 번 갱신된다고 가이드에 적혀 있어 길게 둠
ROUTE_CACHE_SEC=300
# (선택) Redis 캐시 — 서버 여러 대가 캐시를 공유. 쓰려면 backend에서 npm i redis 후 주소 입력
REDIS_URL=

# API 키가 없거나 오류일 때 쓰는 예시 데이터 시나리오: jeongneung | backgate | rain | normal
MOCK_SCENARIO=jeongneung
# 예시 데이터로 계산된 푸시: label(본문에 '예시 교통 데이터 기준' 표시하고 보냄) | skip(보내지 않음)
PUSH_WHEN_MOCK=label

# ── Web Push(VAPID): npx web-push generate-vapid-keys 로 만든 값. 비워 두면 서버 푸시는 꺼집니다. ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 데이터 파일(사용자·평소 소요시간 기록)
DATA_FILE=./data/db.json
