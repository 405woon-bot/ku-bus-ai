# 이 파일을 .env로 복사하고 값을 채우세요:  cp .env.example .env   (.env는 Git에 올리지 마세요)
PORT=8787

# ── 서울시 버스 Open API (공공데이터포털에서 정류소정보조회·노선정보조회 활용 신청 → 같은 일반 인증키) ──
# 서버에만 둡니다. 프런트엔드(HTML/JS)에는 절대 넣지 마세요. 비워 두면 예시(모의) 데이터로 동작합니다.
SEOUL_BUS_API_KEY=
# 기본값은 공식 활용가이드의 서비스 URL입니다(http://ws.bus.go.kr/api/rest).
SEOUL_BUS_BASE_URL=
# 응답 형식: xml(API 기본) | json(resultType=json). 어느 쪽이 와도 해석합니다.
SEOUL_BUS_FORMAT=xml
# 인증키 파라미터 이름: 가이드 예제 URL은 ServiceKey, 일부 요청 표는 serviceKey로 표기 — 인증 오류가 나면 바꿔 보세요.
SEOUL_BUS_KEY_PARAM=ServiceKey
# 서울시 API 응답 대기 시간(ms)
SEOUL_BUS_TIMEOUT_MS=6000
# 캐시 시간(초). 같은 노선·정류장은 이 시간 안에 다시 부르지 않습니다. 개발계정 일일 호출 한도를 확인하고 정하세요.
LIVE_CACHE_SEC=30
# 탑승 정류장 화면에서 노선 경유 정류소(구간 거리·속도)를 다시 부르는 간격(초). 노선정보는 하루 한 번 갱신된다고 가이드에 적혀 있어 길게 둠
ROUTE_CACHE_SEC=300
# (선택) Redis 캐시 — 서버 여러 대가 캐시를 공유. 쓰려면 backend에서 npm i redis 후 주소 입력
REDIS_URL=

# ── 서울시 실시간 돌발정보 (서울 열린데이터광장 data.seoul.go.kr에서 따로 받은 인증키 — 버스 API 키와 다름) ──
# 사고·공사·버스사고·기상/재난·집회및행사 중 통학 경로 300m · 국민대 1km 안의 것만 홈 화면에 보여 줍니다. 비워 두면 이 기능은 꺼집니다.
SEOUL_ACCIDENT_API_KEY=
# 서울 전체 돌발정보를 다시 받는 간격(초). 기본 300(5분), 최소 60. 모든 사용자가 같은 값을 나눠 써서 호출을 아낍니다.
ACCIDENT_CACHE_SEC=300

# ── 기상청 단기예보 조회서비스 · 초단기실황 (공공데이터포털 활용 신청 → 일반 인증키, Encoding · Decoding 둘 다 가능) ──
# 국민대 격자(nx 60 · ny 128)의 지금 강수형태 · 1시간 강수량을 받습니다. 서버 전용. 비워 두면 날씨는 꺼집니다.
KMA_API_KEY=
# 날씨를 다시 받는 간격(초). 기본 600(10분), 600~1800. 개발계정 일일 한도 10,000건을 넘지 않게 모든 사용자가 나눠 씁니다.
WEATHER_CACHE_SEC=600
# (선택) 격자를 바꿀 때만: 기본은 국민대 nx 60 · ny 128
KMA_NX=
KMA_NY=

# ── "왜 늦나요?" AI 한 줄 설명 — Google Gemini API (Google AI Studio에서 만든 API 키) ──
# 버스가 보통 · 혼잡일 때만, 서버가 확인한 사실(느린 도로 · 날씨 · 돌발정보)로 한 문장을 만듭니다. 숫자는 서버가 계산합니다.
# 키는 서버 환경변수에만 둡니다(Render → Environment). 비워 두면 AI 없이 '기본 안내' 문장만 보여 줍니다.
GEMINI_API_KEY=
# 모델 이름. 비워 두면 gemini-3.5-flash-lite(구글이 새 프로젝트에 권장). 404 · '모델을 쓸 수 없어요'가 나오면 바꿔 보세요.
GEMINI_MODEL=
# AI 응답을 기다리는 최대 시간(ms). 기본 3500, 1000~4000. 넘으면 기본 안내로 바로 바꿉니다.
GEMINI_TIMEOUT_MS=3500
# 같은 사실이면 다시 묻지 않는 시간(초). 기본 300(5분), 180~900
EXPLAIN_CACHE_SEC=300
# 하루(한국 시각 기준) 최대 호출 수. 넘으면 그날은 기본 안내만. 무료 한도는 AI Studio의 Rate limit 화면에서 확인하세요.
GEMINI_MAX_PER_DAY=200
# 화면 응답이 AI를 기다리는 최대 시간(ms). 기본 1200. 그보다 늦은 문장은 캐시에 담겨 다음 갱신(몇 초 뒤) 때 나옵니다.
EXPLAIN_WAIT_MS=1200

# API 키가 없거나 오류일 때 쓰는 예시 데이터 시나리오: jeongneung | backgate | rain | normal
MOCK_SCENARIO=jeongneung
# 예시 데이터로 계산된 푸시: label(본문에 '예시 교통 데이터 기준' 표시하고 보냄) | skip(보내지 않음)
PUSH_WHEN_MOCK=label

# ── Web Push(VAPID): npx web-push generate-vapid-keys 로 만든 값. 비워 두면 서버 푸시는 꺼집니다. ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 데이터 파일(사용자·평소 소요시간 기록)
DATA_FILE=./data/db.json
